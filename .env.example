# Copiez ce fichier en .env sur votre machine locale, ou definissez ces
# variables dans les reglages de l'hebergeur (Render, PythonAnywhere...).

# Secret Flask (IMPORTANT : changez ceci avant mise en production)
SECRET_KEY=changez-cette-valeur-longue-et-unique

# Code de votre espace pro /admin (changez-le avant production)
ADMIN_TOKEN=tradescope2026

# Lien de paiement de l'abonnement (Stripe / PayPal / autre)
# Laissez vide tant qu'il n'existe pas : la page abonnement affichera
# "les paiements seront actives sous peu".
PAY_LINK=https://example.com/pay/tradescope

# Nombre d'analyses gratuites offertes par email
FREE_CREDITS=3